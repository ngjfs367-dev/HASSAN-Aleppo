{
  "name": "hasan-documentary",
  "version": "1.0.0",
  "description": "30-second Remotion documentary project titled 'Hasan Documentary'",
  "type": "module",
  "scripts": {
    "start": "remotion preview src/index.ts",
    "build": "remotion render src/index.ts HasanDocumentary out/hasan_documentary.mp4",
    "build:fast": "remotion render src/index.ts HasanDocumentary out/hasan_documentary.mp4 --codec vp8",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "^4.0.0",
    "@remotion/cli": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "typescript": "^5.0.0"
  }
}
