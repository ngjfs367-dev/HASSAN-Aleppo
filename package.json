{
  "name": "hassan-aleppo-documentary",
  "version": "1.1.0",
  "private": true,
  "description": "30-second cinematic Arabic Remotion documentary about Hassan.",
  "type": "module",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts HasanDocumentary out/hasan_documentary.mp4",
    "build": "npm run render",
    "build:fast": "remotion render src/index.ts HasanDocumentary out/hasan_documentary.webm --codec vp8",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "typescript": "^5.0.0"
  }
}
